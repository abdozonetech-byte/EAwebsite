# Supabase CRM
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-cloudflare-secret

# Private CRM authentication
CRM_USERNAME=replace-with-crm-username
CRM_PASSWORD=replace-with-crm-password
CRM_SESSION_SECRET=replace-with-long-random-secret

# WhatsApp Business Cloud API admin notifications
# Destination in E.164 format, digits only (for example: 212600000000).
WHATSAPP_ADMIN_TO=replace-with-admin-phone-e164
WHATSAPP_ACCESS_TOKEN=replace-with-permanent-meta-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_GRAPH_API_VERSION=replace-with-current-supported-version
WHATSAPP_ADMIN_TEMPLATE=new_lead_admin_notification
WHATSAPP_ADMIN_TEMPLATE_LANG=fr

# ChatGPT custom MCP app OAuth 2.1
# Create these as Cloudflare secrets/variables; never expose them in CRM JavaScript.
MCP_OAUTH_CLIENT_ID=replace-with-chatgpt-mcp-client-id
MCP_OAUTH_CLIENT_SECRET=replace-with-long-random-client-secret
# Comma-separated exact callback URL(s) shown by ChatGPT when adding the MCP server.
MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/replace-with-exact-callback
